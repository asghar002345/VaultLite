# Copy to .env and fill in. Get a project id at https://dashboard.reown.com
EXPO_PUBLIC_REOWN_PROJECT_ID=REPLACE_ME
# MilestoneEscrow on Base Sepolia (84532) — leave empty until deployed
EXPO_PUBLIC_ESCROW_ADDRESS_BASE_SEPOLIA=
# Base URL of the bundler/paymaster proxy (docs/BUNDLER_PROXY.md), e.g. https://vaultlite-api.vercel.app
# The Pimlico API key lives ONLY on that server (PIMLICO_API_KEY) — never in this file.
EXPO_PUBLIC_BUNDLER_PROXY_URL=
