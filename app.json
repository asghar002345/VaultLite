{
  "expo": {
    "name": "VaultLite",
    "slug": "vaultlite",
    "version": "4.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vaultlite",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.vaultlite.demo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vaultlite.demo",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow VaultLite to use Face ID to unlock your wallet."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow VaultLite to use Face ID to unlock your wallet."
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "VaultLite uses the camera to scan wallet addresses and WalletConnect QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-dontwarn java.awt.**\n-keep class com.sun.jna.** { *; }\n-keep class * implements com.sun.jna.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "reownProjectId": "REPLACE_ME",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "886673c6-ae9d-4c12-bc61-b3dd6308cab4"
      }
    },
    "owner": "hammad_asghar"
  }
}
